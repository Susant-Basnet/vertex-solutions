{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "80rem",
			"wideSize": "80rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Navy",
					"slug": "navy",
					"color": "#1E293B"
				},
				{
					"name": "Ink",
					"slug": "ink",
					"color": "#0F172A"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#2563EB"
				},
				{
					"name": "Primary Dark",
					"slug": "primary-dark",
					"color": "#1D4ED8"
				},
				{
					"name": "Teal",
					"slug": "teal",
					"color": "#0D9488"
				},
				{
					"name": "Amber",
					"slug": "amber",
					"color": "#F59E0B"
				},
				{
					"name": "Amber Dark",
					"slug": "amber-dark",
					"color": "#B45309"
				},
				{
					"name": "Background",
					"slug": "background",
					"color": "#F8FAFC"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#FFFFFF"
				},
				{
					"name": "Subtle",
					"slug": "subtle",
					"color": "#F1F5F9"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#E2E8F0"
				},
				{
					"name": "Border Strong",
					"slug": "border-strong",
					"color": "#CBD5E1"
				},
				{
					"name": "Slate 300",
					"slug": "slate-300",
					"color": "#CBD5E1"
				},
				{
					"name": "Slate 400",
					"slug": "slate-400",
					"color": "#94A3B8"
				},
				{
					"name": "Slate 500",
					"slug": "slate-500",
					"color": "#64748B"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#475569"
				},
				{
					"name": "Slate 700",
					"slug": "slate-700",
					"color": "#334155"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"slug": "x-small",
					"size": "0.75rem"
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Lead",
					"slug": "lead",
					"size": "1.125rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem"
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "clamp(1.875rem, 1.5rem + 1.5vw, 2.25rem)"
				},
				{
					"name": "XX Large",
					"slug": "xx-large",
					"size": "clamp(2.25rem, 1.5rem + 3vw, 3.75rem)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"name": "2",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "3",
					"slug": "30",
					"size": "0.75rem"
				},
				{
					"name": "4",
					"slug": "40",
					"size": "1rem"
				},
				{
					"name": "5",
					"slug": "50",
					"size": "1.5rem"
				},
				{
					"name": "6",
					"slug": "60",
					"size": "2rem"
				},
				{
					"name": "7",
					"slug": "70",
					"size": "3rem"
				},
				{
					"name": "8",
					"slug": "80",
					"size": "5rem"
				}
			]
		},
		"border": {
			"radius": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"custom": {
			"borderWidth": {
				"default": "2px",
				"strong": "4px"
			},
			"transition": "0.15s ease-in-out"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--navy)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.625"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--60)",
						"right": "var(--wp--preset--spacing--60)"
					}
				},
				"border": {
					"radius": "0"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--slate-700)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--navy)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"width": "0"
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
